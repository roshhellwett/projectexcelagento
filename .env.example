# ExcelAgento environment
#
# ExcelAgento is a zero-secret deployment: it uses the BYOK (Bring Your Own Key)
# model, so the user supplies their own provider key at runtime and it is kept in
# their browser's localStorage. No API key is required to build or deploy.
#
# This file documents the optional settings below; none are required.

# Optional: default provider pre-selected in the BYOK gate (groq | openrouter | gemini).
# VITE_DEFAULT_PROVIDER=groq

# Optional: custom base URL for a self-hosted gateway or proxy.
# VITE_API_BASE_URL=
